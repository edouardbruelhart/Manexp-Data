# ===== Mailer configuration =====

EMAIL_SENDER=sender.email@gmail.com  # Address that will send the message
EMAIL_SENDER_PASSWORD=your-email-password # Please create an app password to avoid using real email password
EMAIL_RECEIVER=receiver.email@gmail.com # Address that will receive the message
SMTP=smtp.gmail.com # Replace with your email provider smtp


# ===== PostgreSQL configuration =====

POSTGRES_PORT=5432
POSTGRES_ADMIN_USER=admin
POSTGRES_ADMIN_PASSWORD=your-admin-passowrd
POSTGRES_PIPELINE_USER=pipeline
POSTGRES_PIPELIN_PASSWORD=your-pipeline-password
POSTGRES_DB=your_db
